<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KW Video Alert"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Kountry Wayne ki nayi video aate hi awaz aayegi"
        android:textSize="16sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Notification access: NAHI mila — neeche wala button dabao"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <Button
        android:id="@+id/btnNotifAccess"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="20dp"
        android:text="Notification Access Do"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Aakhri alert:"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvLastAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Abhi tak koi alert nahi aya"
        android:textSize="19sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnTest"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="30dp"
        android:text="Test Alert Sound"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Alert ki awaz:"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSoundName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Voice: Video aa gayi!"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnVoice"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="Voice use karo"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnPickFile"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="Phone se file select karo"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Bot ka message aate hi app bol paregi. Telegram me KW Video Alert bot wali chat ko mute na karna."
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Facebook Watch"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Pehle FB Login Karo se apne account me login karo, phir Start Watch dabao. App har 30 second me Kountry Wayne ke reels check karegi — nayi reel aate hi awaz aayegi."
        android:textSize="15sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvWatchState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="FB Watch: band hai"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvFbWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="FB login khatam — dobara login karo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#CC0000"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvFbLastCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Aakhri check: —"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvFbLastCatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Aakhri video pakri: —"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvFbBaseline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Baseline: abhi set nahi"
        android:textSize="16sp" />

    <Switch
        android:id="@+id/switchDaytimeWatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Din me bhi watch karo (24 ghante)"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Band rahe to sirf sham 6 se subha 8 tak watch hoga (Pakistan time)."
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnFbLogin"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="20dp"
        android:text="FB Login Karo"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnStartWatch"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="14dp"
        android:text="Start Watch"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnStopWatch"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="14dp"
        android:text="Stop Watch"
        android:textSize="20sp" />

</LinearLayout>
</ScrollView>
