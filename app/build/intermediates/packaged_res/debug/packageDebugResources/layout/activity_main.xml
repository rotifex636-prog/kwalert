<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KW Video Alert"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Kountry Wayne ki nayi video aate hi awaz aayegi"
        android:textSize="16sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Notification access: NAHI mila — neeche wala button dabao"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <Button
        android:id="@+id/btnNotifAccess"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="20dp"
        android:text="Notification Access Do"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Aakhri alert:"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvLastAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Abhi tak koi alert nahi aya"
        android:textSize="19sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnTest"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="30dp"
        android:text="Test Voice"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Bot ka message aate hi app bol paregi. Telegram me KW Video Alert bot wali chat ko mute na karna."
        android:textSize="16sp" />

</LinearLayout>
